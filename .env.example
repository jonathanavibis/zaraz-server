PORT=5000

# Database Engine Selection ('mysql' for local XAMPP MySQL, 'mongodb' for MongoDB Atlas)
DB_TYPE=mysql

# Local XAMPP MySQL Database Configuration
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=zaraz_db

# MongoDB Fallback (Optional)
MONGODB_URI=
AUTH_DB_NAME=zaraz_auth_db
SERVER_ACC_DB_NAME=SERVER_ACC

JWT_SECRET=your_jwt_secret_key
BETTER_AUTH_SECRET=your_auth_secret
BETTER_AUTH_URL=http://localhost:3000

CLIENT_URL=http://localhost:3000
FRONTEND_URL=http://localhost:3000
